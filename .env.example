# ==============================================================
# StyleHub - Environment Configuration
# ==============================================================
# DATABASE_MODE options: sqlite | mysql
# Leave as "sqlite" for zero-setup local development (default).
# Switch to "mysql" once your MySQL server is ready - just change
# this ONE value and fill in the MYSQL_* fields below.
# ==============================================================
DATABASE_MODE=sqlite

# --- SQLite (used when DATABASE_MODE=sqlite) ---
SQLITE_DB_PATH=stylehub.db

# --- MySQL (used when DATABASE_MODE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=stylehub_db

# --- App / Security ---
SECRET_KEY=change-this-super-secret-key-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_NAME=StyleHub
DEBUG=True

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:8000
